# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://prosanaclinic.com

# WhatsApp number in international format, digits only (no +, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=905421214822

# Public contact details
NEXT_PUBLIC_CONTACT_EMAIL=info@prosanaclinic.com
# Display format is up to you; leave unset to derive it from the WhatsApp number.
NEXT_PUBLIC_CONTACT_PHONE="+90 542 121 48 22"

# --- Email delivery (optional) -------------------------------------------
# If RESEND_API_KEY is set, consultation requests are delivered via Resend.
# Otherwise submissions are validated, accepted and logged to the server console.
RESEND_API_KEY=
LEAD_INBOX=info@prosanaclinic.com
LEAD_FROM="PROSANA Website <no-reply@prosanaclinic.com>"
